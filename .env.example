# Base de l'API consommée par la couche service (app/services/api.ts).
# En local on utilise les routes mock Nuxt (/api). En production, pointer
# vers l'API Symfony.
NUXT_PUBLIC_API_BASE=/api

# URL publique du POC PWA, utilisée pour les métadonnées et les tests de déploiement.
NUXT_PUBLIC_SITE_URL=https://pwa.graines-digitales.online
